{#
  OctoPrint 2.0 renders connector options (the "Connection Type" selector plus
  each connector's own parameters, e.g. Moonraker's host/port/apikey) ONLY inside
  the core sidebar/connection/connection.jinja2. Because this plugin replaces
  that panel, those inputs would otherwise never be rendered and connecting to a
  non-serial connector would send empty parameters.

  So we render the block ourselves here. The markup mirrors the core template
  exactly, because OctoPrint's connection view model depends on the DOM
  contract: doOnAllInputsForConnector() looks up #connection_options_<connector>
  and collects the [data-connection-parameter] inputs inside it.

  OctoPrint 1.11 has no connection_options templates at all, so the whole block
  is skipped there and the panel stays as it was.
#}
{% if templates.connection_options is defined %}
<div id="connection_options_wrapper">
  <label for="connection_option">{{ _('Connection Type') }}</label>
  <select id="connection_option" class="connection_parameter" data-test-id="connection-connector"
    data-bind="options: connectionConnectorOptions, optionsText: 'name', optionsValue: 'connector', value: connectionSelectedConnector, css: {disabled: !connectionState.isErrorOrClosed()}, enable: connectionState.isErrorOrClosed() && loginState.isUser()"></select>

  {% for key in templates.connection_options.order %}
  {% set entry, data = templates.connection_options.entries[key] %}
  <div id="connection_options_{{ data.connector }}_wrapper"
    data-bind="visible: connectionSelectedConnector() == '{{ data.connector }}'">
    {% if "custom_bindings" not in data or data["custom_bindings"] %}<!-- ko allowBindings: false -->{% endif %}
    <div id="connection_options_{{ data.connector }}">
      {% try "There was an error with the template {filename} at line number {lineno}: {exception}" %}
      {% include data.template ignore missing %}
      {% endtry %}
    </div>
    {% if "custom_bindings" not in data or data["custom_bindings"] %}<!-- /ko -->{% endif %}
  </div>
  {% endfor %}
</div>
{% endif %}

<div class="control-group">
  <div class="controls">
    <label for="connection_printers"
      data-bind="css: {disabled: !connectionState.isErrorOrClosed()}, enable: connectionState.isErrorOrClosed() && loginState.isUser()">{{ _('Printer Profile') }}</label>
    <select id="connection_printers"
      data-bind="options: connectionPrinterOptions, optionsText: 'name', optionsValue: 'id', value: connectionSelectedPrinter, css: {disabled: !connectionState.isErrorOrClosed()}, enable: connectionState.isErrorOrClosed() && loginState.isUser()"></select>
    <button class="btn btn-block"
      data-bind="click: connect, text: connectionState.buttonText(), enable: loginState.isUser()">{{ _('Connect') }}</button>

    <div class="btn-group action-buttons klipper-row-fluid">
      <!-- ko ifnot: settings.settings.plugins.klipper.connection.hide_editor_button -->
      <button class="btn klipper-fluid-item-1" title="{{ _('Open Editor') }}"
        data-bind="visible: hasPermKo('CONFIG'), click: showEditorDialog">{{ _('Open Editor') }}</button>
      <!-- /ko -->
    </div>

  </div>
</div>
<!-- ko if: settings.settings.plugins.klipper.configuration.shortStatus_sidebar -->
<div id="shortStatus_SideBar" class="plugin-klipper-sidebar"
  data-bind="css: { KlipperShortStatusWarning: shortStatus_type()=='warning', KlipperShortStatusError: shortStatus_type()=='error' }">
  <a class="msg" title="{{ _('Go to OctoKlipper Tab') }}"
    data-bind="click: navbarClicked, html: shortStatus_sidebar, style: { color: shortStatus_type()=='warning' || shortStatus_type()=='error' ? 'black' : '' }"></a>
</div>
<!-- /ko -->
